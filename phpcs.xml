<?xml version="1.0"?>
<ruleset name="api-base">
	<description>Coding standard for api-base</description>
	<arg name="tab-width" value="4"/>
	<arg name="parallel" value="75"/>

	<!-- 2.1 Basic Coding Standard -->
	<rule ref="./library.xml"/>

	<file>src</file>

	<rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
	<properties>
		<property name="rootNamespaces" type="array">
				<element key="src/Stefna" value="Stefna"/>
		</property>
	</properties>
</rule>
</ruleset>
