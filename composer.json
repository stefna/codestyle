	"require": {
		"php": "^8.4",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"bin": [
		"bin/stefna-hook-install"
	],
	"require-dev": {
		"phpunit/phpunit": "^12.5"
	}
}
