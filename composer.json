{
	"name": "stefna/codestyle",
	"description": "Custom php sniffer for stefna",
	"license": "MIT",
	"authors": [
		{
			"name": "Andreas",
			"email": "andreas@stefna.is"
		}
	],
	"autoload": {
		"psr-4": {
			"Stefna\\": "src/Stefna/"
		}
	},
	"autoload-dev": {
